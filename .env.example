# Copy this file to .env (same folder) and fill it in. Leave DATABASE_URL out to use the built-in SQLite database.
# If your database password has symbols like @ # / : replace each with its %-code (for example @ becomes %40).
DATABASE_URL=
PORT=3000
PGSSL=0

# Optional AI story/question generation (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=30

# Optional private Supabase Storage uploads (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=

# Optional security / deployment
HTTPS=0
CORS_ORIGINS=
