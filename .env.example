# Copy this file to .env (same folder) and fill it in. Leave DATABASE_URL out to use the built-in SQLite database.
# If your database password has symbols like @ # / : replace each with its %-code (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PORT=3000
